# ---------------------------------------------------------------------------
# Copy to .env before running `docker compose up`:
#
#   cp .env.example .env
#
# .env is git-ignored. The two REQUIRED values below have no defaults in
# docker-compose.yml on purpose - compose fails fast rather than booting with a
# secret that is published in this repository.
# ---------------------------------------------------------------------------

# REQUIRED. Password for the Postgres role the backend connects as.
POSTGRES_PASSWORD=change-me-to-something-random

# REQUIRED. HMAC-SHA256 signing key for JWTs. Must be at least 32 characters
# (256 bits) or the backend refuses to start. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48-at-least-32-chars-long

# ---- Optional overrides ---------------------------------------------------

# POSTGRES_DB=taskflow
# POSTGRES_USER=taskflow

# How long an issued token stays valid.
# JWT_EXPIRATION_MINUTES=120

# Host ports. Change if 3000/8080 are already in use.
# FRONTEND_PORT=3000
# BACKEND_PORT=8080

# Extra browser origins allowed to call the API directly. Not needed for the
# compose setup itself, where the frontend is same-origin behind nginx.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seed a single ADMIN account on first boot. Registration always creates USER
# accounts, so this is the only way to get an admin. Leave disabled unless you
# need the ADMIN-only endpoints.
# ADMIN_SEED_ENABLED=true
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@taskflow.local
# ADMIN_PASSWORD=pick-a-strong-password
